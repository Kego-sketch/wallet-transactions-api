{
  "name": "wallet-transactions-api",
  "version": "1.0.0",
  "description": "Minimal wallet transactions REST API used to demonstrate a CI/CD pipeline (lint, test, scan, build, release).",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "lint": "eslint src tests",
    "test": "jest --ci --testPathIgnorePatterns=integration",
    "test:integration": "jest --ci --testPathPattern=integration",
    "build": "node scripts/build.js"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
